<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath Condition="'$(Configuration)' == 'Debug'">..\bin_dbg\</OutputPath>
    <OutputPath Condition="'$(Configuration)' == 'Release'">..\bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NuklearDotNet\NuklearDotNetDotnet.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <None Include="..\bin_dbg\Nuklear2.dll" Link="Nuklear2.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Include="..\bin\Nuklear2.dll" Link="Nuklear2.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
