<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputPath Condition="'$(Configuration)' == 'Debug'">..\bin_dbg\</OutputPath>
    <OutputPath Condition="'$(Configuration)' == 'Release'">..\bin\</OutputPath>
    <NativeNuklearDll Condition="'$(Configuration)' == 'Debug'">$(MSBuildProjectDirectory)\..\bin_dbg\Nuklear2.dll</NativeNuklearDll>
    <NativeNuklearDll Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)\..\bin\Nuklear2.dll</NativeNuklearDll>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExampleShared\ExampleSharedDotnet.csproj" />
    <ProjectReference Include="..\FishGfx\FishGfx\FishGfx.csproj" />
    <ProjectReference Include="..\NuklearDotNet\NuklearDotNetDotnet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\FishGfx\FishGfx\data\**\*">
      <Link>data\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\FishGfx\FishGfx\glfw3.dll">
      <Link>glfw3.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyNuklearNativeDll" AfterTargets="Build">
    <Error Condition="!Exists('$(NativeNuklearDll)')" Text="Build Nuklear2.dll for $(Configuration) x64 before building Example_FishGfx." />
    <Copy SourceFiles="$(NativeNuklearDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
